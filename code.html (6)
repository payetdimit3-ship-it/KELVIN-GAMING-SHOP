<!DOCTYPE html><html lang="sw"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>My Games — GameHub</title><link rel="stylesheet" href="style.css"></head><body>
<header class="navbar"><div class="logo">🎮 <span>GAME</span>HUB</div><nav class="nav-links"><a href="index.html">Home</a><a href="shop.html">Shop</a><a href="mygames.html">🎮 My Games</a><a href="rental.html">Rental</a></nav></header>
<div class="mygames-page"><h1>🎮 Games Zangu</h1><p class="section-sub">Cheza kwenye GeForce NOW — unahitaji muda wa rental ulio-active</p>
<div id="myGamesContent"><div class="timer-box"><div class="countdown" id="cd">00:00:00</div><p class="label">Muda uliobaki wa rental</p></div>
<p style="color:#8f8faa;text-align:center;">Huna muda wa rental ulio-active. Nenda kwenye Rental kununua muda.</p>
<div style="text-align:center;margin-top:15px;"><a href="rental.html" class="btn-primary">⏱️ Nunua Muda</a>
<a href="https://play.geforcenow.com" target="_blank" class="btn-secondary">🚀 Fungua GeForce NOW</a></div></div></div>
<script>
const end=localStorage.getItem('gamehubRentalEnd');const cd=document.getElementById('cd');if(end){setInterval(()=>{const diff=Math.max(0,parseInt(end)-Date.now());if(diff<=0){cd.textContent='⏰ Muda Umeishia';document.getElementById('myGamesContent').innerHTML+='<p style="color:#ff3d71;text-align:center;margin-top:10px;">Muda wako wa rental umeishia. Nenda Rental kununua mpya.</p>';return;}const h=Math.floor(diff/3600000),m=Math.floor((diff%3600000)/60000),s=Math.floor((diff%60000)/1000);cd.textContent=`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;},1000);}else{cd.textContent='⏸️ Hakuna Rental';}
</script>
</body></html>
