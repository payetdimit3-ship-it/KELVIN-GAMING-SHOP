<!DOCTYPE html><html lang="sw"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Ingia — GameHub</title><link rel="stylesheet" href="style.css"></head><body>
<header class="navbar"><div class="logo">🎮 <span>GAME</span>HUB</div><nav class="nav-links"><a href="index.html">Home</a><a href="shop.html">Shop</a><a href="account.html">Account</a></nav></header>
<div class="account-page"><h1>🔐 Ingia / Jisajili</h1>
<div class="form-card"><h3>Ingia</h3><div class="form-group"><label>Email</label><input type="email" id="loginEmail" placeholder="email@example.com"></div><div class="form-group"><label>Password</label><input type="password" id="loginPassword" placeholder="******"></div><button class="btn-primary" onclick="loginUser()" style="width:100%">🔐 Ingia</button><p id="loginMsg" style="color:#ff3d71;margin-top:10px;font-size:13px;"></p></div>
<div class="form-card"><h3>Jisajili</h3><div class="form-group"><label>Jina</label><input type="text" id="regName" placeholder="Jina lako"></div><div class="form-group"><label>Email</label><input type="email" id="regEmail" placeholder="email@example.com"></div><div class="form-group"><label>Namba ya Simu</label><input type="text" id="regPhone" placeholder="+255 700 000 000"></div><div class="form-group"><label>Password</label><input type="password" id="regPassword" placeholder="******"></div><button class="btn-primary" onclick="registerUser()" style="width:100%">✅ Jisajili</button><p id="regMsg" style="color:#ff3d71;margin-top:10px;font-size:13px;"></p></div>
</div>
<script>
async function loginUser(){const email=document.getElementById('loginEmail').value.trim();const password=document.getElementById('loginPassword').value;const msg=document.getElementById('loginMsg');if(!email||!password){msg.textContent='Jaza email na password.';return;}msg.textContent='⏳ Inaingia...';msg.style.color='#8f8faa';try{const r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});const d=await r.json();if(d.success){localStorage.setItem('gamehubToken',d.token);localStorage.setItem('gamehubUser',JSON.stringify(d.user));window.location='account.html';}else{msg.textContent=d.error||'Email au password sio sahihi';msg.style.color='#ff3d71';}}catch(e){msg.textContent='Hitilafu ya mtandao.';msg.style.color='#ff3d71';}}
async function registerUser(){const name=document.getElementById('regName').value.trim();const email=document.getElementById('regEmail').value.trim();const phone=document.getElementById('regPhone').value.trim();const password=document.getElementById('regPassword').value;const msg=document.getElementById('regMsg');if(!name||!email||!password){msg.textContent='Jaza sehemu zote.';return;}msg.textContent='⏳ Inajisajili...';msg.style.color='#8f8faa';try{const r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,email,phone,password})});const d=await r.json();if(d.success){localStorage.setItem('gamehubToken',d.token);localStorage.setItem('gamehubUser',JSON.stringify(d.user));window.location='account.html';}else{msg.textContent=d.error||'Hitilafu';msg.style.color='#ff3d71';}}catch(e){msg.textContent='Hitilafu ya mtandao.';msg.style.color='#ff3d71';}}
</script>
</body></html>
