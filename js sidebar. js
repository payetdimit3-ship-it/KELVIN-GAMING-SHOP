  load: async function() {
    if (!window.DB) return;
    
    const nav = document.getElementById('sidebar-nav');
    if (!nav) return;
    
    // Loading skeleton
    nav.innerHTML = `
      <div class="px-4 py-2">
        <div class="skeleton h-10 rounded-lg mb-2"></div>
        <div class="skeleton h-10 rounded-lg mb-2"></div>
        <div class="skeleton h-10 rounded-lg mb-2"></div>
      </div>
    `;
    
    try {
      const { data, error } = await window.DB
        .from('sidebar_menu')
        .select('*')
        .eq('is_active', true)
        .order('display_order');
      
      if (error || !data) {
        console.warn('Sidebar menu haipo kwenye DB');
        return;
      }
      
      // Group by group_name
      const groups = {};
      data.forEach(item => {
        if (!groups[item.group_name]) groups[item.group_name] = [];
        groups[item.group_name].push(item);
      });
      
      nav.innerHTML = '';
      
      Object.keys(groups).forEach(groupName => {
        const groupEl = document.createElement('div');
        groupEl.className = 'mb-4';
        
        const title = document.createElement('div');
        title.className = 'px-4 py-2 text-[10px] uppercase tracking-wider text-gray-500 font-bold';
        title.textContent = groupName;
        groupEl.appendChild(title);
        
        groups[groupName].forEach(item => {
          const link = document.createElement('a');
          link.href = item.link || '#';
          
          // Check if active
          const currentPath = window.location.pathname;
          const isActive = currentPath === item.link || 
                          (item.link !== '/' && currentPath.startsWith(item.link.replace('.html', '')));
          
          link.className = `flex items-center gap-3 px-4 py-2.5 mx-2 rounded-lg text-sm transition ${
            isActive 
              ? 'bg-primary text-white' 
              : 'text-gray-300 hover:bg-dark-3 hover:text-white'
          }`;
          
          const icon = this.iconMap[item.icon] || this.iconMap.games;
          
          link.innerHTML = `
            <svg class="w-5 h-5 ${isActive ? 'text-white' : 'text-gray-400'}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              ${icon}
            </svg>
            <span>${item.label}</span>
          `;
          
          groupEl.appendChild(link);
        });
        
        nav.appendChild(groupEl);
      });
      
    } catch(e) {
      console.error('Sidebar load error:', e);
    }
  }
};

